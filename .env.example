# Copy to .env for local development: cp .env.example .env
# Every variable the app reads is listed here. Never commit real values.

# Runtime connection used by the app.
#   Local: the compose Postgres. Until Phase 3 this is the owner; from Phase 3
#          it must be the non-superuser, non-owner app_user role.
#   Production: Neon POOLED connection string (host contains "-pooler"), as app_user.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/restaurant"

# Migrations only (read by prisma.config.ts, never by the app).
#   Production: Neon DIRECT connection string, as the database owner.
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/restaurant"

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL="info"

# AI menu import (optional — leave empty to disable the import; the rest of
# the app works without it). OpenAI-compatible gateway.
AI_BASE_URL=""
AI_API_KEY=""
AI_MODEL=""
