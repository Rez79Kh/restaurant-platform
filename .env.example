# Copy to .env for local development: cp .env.example .env
# Every variable the app reads is listed here. Never commit real values.

# Runtime connection used by the app.
#   Always the non-superuser, non-owner app_user role: superusers and table
#   owners bypass Row-Level Security, which would silently disable isolation.
#   Production: Neon POOLED connection string (host contains "-pooler").
DATABASE_URL="postgresql://app_user:app_user_local@localhost:5433/restaurant"

# Migrations only (read by prisma.config.ts, never by the app).
#   Production: Neon DIRECT connection string, as the database owner.
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/restaurant"

# Password applied to app_user by `npm run db:setup` (scripts/set-app-db-password.mts).
# Must match the password in DATABASE_URL. Local value only; in production set
# the app_user password in the Neon console or run the script once.
APP_DB_PASSWORD="app_user_local"

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL="info"

# AI menu import (optional — leave empty to disable the import; the rest of
# the app works without it). OpenAI-compatible gateway.
AI_BASE_URL=""
AI_API_KEY=""
AI_MODEL=""
